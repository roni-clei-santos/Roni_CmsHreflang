<?xml version="1.0"?>
<ruleset name="Roni_CmsHreflang">
    <description>Magento 2 coding standard for Roni_CmsHreflang</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php,phtml,xml"/>
    <arg name="cache" value=".phpcs-cache"/>
    <!-- Every warning counts, including the low severity ones the default (5) hides -->
    <arg name="warning-severity" value="1"/>
    <arg value="sp"/>

    <rule ref="Magento2"/>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/e2e/*</exclude-pattern>
    <!-- Vendored Magento rules and command line tooling, not module code -->
    <exclude-pattern>*/dev/phpmd/*</exclude-pattern>
    <exclude-pattern>*/dev/ci/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/test-results/*</exclude-pattern>
    <exclude-pattern>*/phpcs.xml.dist</exclude-pattern>
    <exclude-pattern>*/phpunit.xml.dist</exclude-pattern>
</ruleset>
